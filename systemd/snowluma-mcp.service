[Unit]
Description=SnowLuma Remote MCP Server (Streamable HTTP / SSE)
After=network.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/your-service
EnvironmentFile=/opt/your-service/config.env
ExecStart=/opt/your-service/venv/bin/python /opt/your-service/server.py
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
