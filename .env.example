# ==========================================
# SnowLuma Remote MCP Configuration Template
# ==========================================

# MCP Service Bindings
MCP_HOST=127.0.0.1
MCP_PORT=8766

# Bearer Token for Remote MCP Client Authentication (Generate a random string)
MCP_AUTH_TOKEN=your_custom_mcp_bearer_token_here

# Upstream SnowLuma OneBot HTTP Service
SNOWLUMA_API_BASE=http://127.0.0.1:3000
SNOWLUMA_API_TOKEN=your_snowluma_http_access_token_here
SNOWLUMA_TIMEOUT=30.0

# ---- view_image（按需取图，1.3.0 起）----
# 默认值即可用，下列全部可选；VIEW_IMAGE_ENABLED=0 则不注册该工具
# VIEW_IMAGE_ENABLED=1
# VIEW_IMAGE_MAX_EDGE=1024
# VIEW_IMAGE_TARGET_BYTES=204800
# VIEW_IMAGE_MAX_SOURCE_BYTES=20971520
# VIEW_IMAGE_CACHE_BYTES=67108864
# VIEW_IMAGE_ALLOWED_HOSTS=qq.com,qq.com.cn
